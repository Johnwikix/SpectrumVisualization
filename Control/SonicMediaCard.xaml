<UserControl
    x:Class="WinExSpectrumTest.Control.SonicMediaCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Border Width="300" Padding="14" CornerRadius="16" Background="#73000000" BorderBrush="#0FFFFFFF" BorderThickness="1"
                Opacity="{x:Bind ViewModel.CardOpacity, Mode=OneWay}">
            <Border.OpacityTransition><ScalarTransition Duration="0:0:0.6" /></Border.OpacityTransition>
            <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
                <Border Width="76" Height="76" CornerRadius="13">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind ViewModel.Cover, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Padding="0,7,0,7">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="14" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="{x:Bind ViewModel.Artist, Mode=OneWay}" FontSize="11" Foreground="#48FFFFFF" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ProgressBar Height="4" VerticalAlignment="Center" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Foreground="#B0A6D9FF" Background="#0DFFFFFF" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TimeText, Mode=OneWay}" FontSize="9.5" Foreground="#80FFFFFF" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>
