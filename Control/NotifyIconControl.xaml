<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinExSpectrumTest.Control.NotifyIconControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:WinExSpectrumTest.Extensions"
    xmlns:local="using:WinExSpectrumTest.Control"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d">

    <Grid>
        <tb:TaskbarIcon
            x:Name="NotifyIcon"
            x:FieldModifier="public"
            ContextMenuMode="SecondWindow"
            DataContext="{Binding}"
            IconSource="ms-appx:///Assets/icon.ico"
            ToolTipText="Spectrum"
            LeftClickCommand="{x:Bind ShowMainWindowCommand}"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <ToggleMenuFlyoutItem
                        x:Name="WallpaperMode"
                        x:Uid="WallpaperMode"
                        AutomationProperties.AutomationId="WallpaperMode"
                        IsChecked="{x:Bind ViewModel.WallpaperEnabled, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleWallpaperModeCommand}">
                        <ToggleMenuFlyoutItem.Icon>
                            <SymbolIcon Symbol="Pictures" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="Unlock"
                        x:Uid="UnlockWindow"
                        Command="{x:Bind UnlockWindowCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE785;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <!-- 效果子菜单走 MVVM：模型树由 ViewModel.TrayEffectMenu 提供，
                         展开时经 PrepareCommand 刷新选中态后重建（见 Extensions/MenuFlyoutExtensions）。 -->
                    <MenuFlyoutSubItem
                        x:Name="SwitchEffect"
                        x:Uid="SwitchEffect"
                        extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.TrayEffectMenu, Mode=OneWay}"
                        extensions:MenuFlyoutExtensions.PrepareCommand="{x:Bind ViewModel.PrepareTrayEffectMenuCommand}">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE71D;" />
                        </MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem
                        x:Name="Settings"
                        x:Uid="Settings"
                        Command="{x:Bind SettingCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="Exit"
                        x:Uid="Exit"
                        Command="{x:Bind ExitApplicationCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE89F;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</UserControl>
