<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="WinExSpectrumTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinExSpectrumTest.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:WinExSpectrumTest.Extensions"
    xmlns:local="using:WinExSpectrumTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:myCanvas="using:WinExSpectrumTest.Canvas"
    xmlns:winex="using:WinUIEx"
    Title="WinExSpectrumTest">

    <winex:WindowEx.SystemBackdrop>
        <winex:TransparentTintBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid x:Name="MyMainwindow">
        <controls:NotifyIconControl x:Name="AppNotifyIconControl" MinWidth="0" />
        <Grid
            x:Name="VisualizerHost"
            Margin="1,1,1,1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Canvas.ZIndex="1">
            <myCanvas:CanvasPanel x:Name="MyCanvas" />
        </Grid>

        <!--
            自绘标题栏（music_player 同款）：悬停显示，左侧锁定/场景/设置 + 右侧窗口控制，
            中段为系统拖动区（SetDragRectangles，见代码）
        -->
        <Grid
            x:Name="AppTitleBar"
            Height="40"
            VerticalAlignment="Top"
            Background="Transparent"
            Canvas.ZIndex="999"
            Opacity="0"
            PointerEntered="AppTitleBar_PointerEntered"
            PointerExited="AppTitleBar_PointerExited">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Left" Modifiers="Control" Invoked="PreviousEffectKeyboardAccelerator_Invoked" />
                <KeyboardAccelerator Key="Right" Modifiers="Control" Invoked="NextEffectKeyboardAccelerator_Invoked" />
            </Grid.KeyboardAccelerators>
            <StackPanel
                x:Name="LeftButtons"
                Margin="0"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="LockBtn"
                    x:Uid="LockButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind MainViewModel.ToggleLockCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE72E;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="L" />
                    </Button.KeyboardAccelerators>
                </Button>
                <DropDownButton
                    x:Name="SceneSwitcher"
                    x:Uid="SceneSwitcher"
                    Height="32"
                    MinWidth="180"
                    MaxWidth="240"
                    Margin="2,0"
                    Padding="12,0,8,0"
                    HorizontalContentAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SceneSwitcher"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE71D;" />
                        <TextBlock
                            MaxWidth="164"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.ActiveSceneName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout
                            extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.SceneMenu, Mode=OneWay}"
                            extensions:MenuFlyoutExtensions.PrepareCommand="{x:Bind ViewModel.PrepareSceneMenuCommand}" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    x:Uid="SettingsButton"
                    AutomationProperties.AutomationId="OpenSettings"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ShowSettingsCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
            <StackPanel
                x:Name="RightButtons"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Uid="WallpaperButton"
                    AutomationProperties.AutomationId="ToggleWallpaperMode"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ToggleWallpaperModeCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE91B;" />
                </Button>
                <Button
                    x:Name="FullScreenBtn"
                    x:Uid="FullScreenButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind MainViewModel.ToggleFullScreenCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" />
                    </Button.KeyboardAccelerators>
                    <FontIcon
                        FontSize="14"
                        Glyph="{x:Bind MainViewModel.FullScreenGlyph, Mode=OneWay}" />
                </Button>
                <Button
                    x:Uid="MinimizeButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind MainViewModel.MinimizeCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE738;" />
                </Button>
                <Button
                    x:Uid="MaximizeButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind MainViewModel.ToggleMaximizeCommand}">
                    <FontIcon
                        FontSize="14"
                        Glyph="{x:Bind MainViewModel.MaximizeGlyph, Mode=OneWay}" />
                </Button>
                <Button
                    x:Uid="CloseButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind MainViewModel.CloseWindowCommand}">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</winex:WindowEx>
