<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinExSpectrumTest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinExSpectrumTest.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinExSpectrumTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:myCanvas="using:WinExSpectrumTest.Canvas"
    xmlns:winex="using:WinUIEx"
    Title="WinExSpectrumTest">

    <Window.SystemBackdrop>
        <winex:TransparentTintBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="MyMainwindow">
        <controls:NotifyIconControl x:Name="AppNotifyIconControl" MinWidth="0" />
        <Grid
            Margin="1,1,1,1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Canvas.ZIndex="1">
            <myCanvas:CanvasPanel x:Name="MyCanvas" />
        </Grid>

        <!--  自绘标题栏（music_player 同款）：悬停显示，左侧窗口控制 + 右侧最小化/最大化/关闭，
              中段为系统拖动区（SetDragRectangles，见代码）  -->
        <Grid
            x:Name="AppTitleBar"
            Height="40"
            VerticalAlignment="Top"
            Background="Transparent"
            Canvas.ZIndex="999"
            Opacity="0"
            PointerEntered="AppTitleBar_PointerEntered"
            PointerExited="AppTitleBar_PointerExited">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <StackPanel
                x:Name="LeftButtons"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="LockBtn"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="LockButton_Click">
                    <FontIcon FontSize="14" Glyph="&#xE72E;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="L" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button
                    x:Name="FullScreenBtn"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="FullScreen_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" />
                    </Button.KeyboardAccelerators>
                    <FontIcon
                        x:Name="FullScreenIcon"
                        FontSize="14"
                        Glyph="&#xE740;" />
                </Button>
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Click="PreviousEffect_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Left" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Click="NextEffect_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Right" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                </Button>
            </StackPanel>
            <StackPanel
                x:Name="RightButtons"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MinimizeButton_Click">
                    <FontIcon FontSize="14" Glyph="&#xE738;" />
                </Button>
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MaximizeButton_Click">
                    <FontIcon
                        x:Name="MaximizeIcon"
                        FontSize="14"
                        Glyph="&#xE71A;" />
                </Button>
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
