<Project>
  <PropertyGroup><FoliaTextRoot>$(MSBuildThisFileDirectory)..\</FoliaTextRoot></PropertyGroup>
  <ItemGroup>
    <Content Include="$(FoliaTextRoot)Native\FoliaText\bin\Spectrum.FoliaText.dll" Link="Spectrum.FoliaText.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(FoliaTextRoot)External\Folia\msdfgen\LICENSE.txt" Link="Licenses\msdfgen.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildFoliaTextBridge" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipFoliaTextNativeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(FoliaTextRoot)Native\FoliaText\Build.ps1&quot; -Win2DIncludePath &quot;$(NuGetPackageRoot)\microsoft.graphics.win2d\1.4.0\include\x64&quot;" />
  </Target>
</Project>
