<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinExSpectrumTest.Canvas.CanvasPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinExSpectrumTest.Canvas"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RenderHost">
        <canvas:CanvasAnimatedControl
            x:Name="SpectrumCanvasControl"
            Paused="True"
            VerticalAlignment="Stretch"
            Draw="SpectrumCanvasControl_Draw"
            Update="SpectrumCanvasControl_Update" />
        <Border Margin="12" Padding="12,8" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top"
            Canvas.ZIndex="10" IsHitTestVisible="False" MaxWidth="560"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            Visibility="{x:Bind DebugOverlay.Visibility, Mode=OneWay}">
            <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind DebugOverlay.Text, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>
