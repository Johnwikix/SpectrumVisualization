<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Audio/SpectrumAnalyzer.cs;../../../Audio/LoopbackWaveFormat.cs" LinkBase="Audio" />
    <Compile Include="../../../Effects/Sonic/**/*.cs" LinkBase="Sonic" />
    <Compile Include="../../../Rendering/GpuGraphics.cs;../../../Rendering/ColorOutputPipelines.cs;../../../Rendering/ParticleVertex.cs;../../../Rendering/IGpuVisualizerEffect.cs;../../../Rendering/ShaderCompiler.cs" LinkBase="Rendering" />
    <Compile Include="../../../Model/SonicQualitySettings.cs" LinkBase="Settings" />
    <Compile Include="../../../Rendering/GpuFramePacer.cs" LinkBase="Rendering" />
    <Compile Include="../../../Rendering/SmaaPass.cs;../../../Rendering/TemporalReconstruction.cs" LinkBase="Rendering" />
    <EmbeddedResource Include="../../../External/FXAA/Fxaa3_11.h" LogicalName="Spectrum.Fxaa3_11.h" />
    <Compile Include="../../../Model/AppSettings.cs;../../../Model/SaveSetting.cs;../../../Manager/SettingsJsonContext.cs;../../../Manager/SettingManager.cs" LinkBase="Settings" />
    <PackageReference Include="ComputeSharp" Version="3.2.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <Import Project="../../../Rendering/ReconstructionAssets.targets" />
</Project>
