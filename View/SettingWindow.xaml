                                            x:Name="FoliaNomandDotSizeSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource FoliaSliderStyle}"
                                            Maximum="1"
                                            Minimum=".1"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            StepFrequency="0.01"
                                            AutomationProperties.LabeledBy="{x:Bind FoliaNomandDotSizeCard}"
                                            Value="{x:Bind ViewModel.FoliaNomandDotSize, Mode=TwoWay}" />
                                    </Grid>
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Name="FoliaNomandDotRadiusCard" x:Uid="FoliaNomandDotRadius">
                                    <Grid ColumnDefinitions="48,220" ColumnSpacing="12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind converters:SliderValueTextConverter.Format(FoliaNomandDotRadiusSlider.Value), Mode=OneWay}" />
                                        <Slider
                                            x:Name="FoliaNomandDotRadiusSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource FoliaSliderStyle}"
                                            Maximum="2"
                                            Minimum=".1"
                                            SmallChange="0.05"
                                            LargeChange="0.25"
                                            StepFrequency="0.05"
                                            AutomationProperties.LabeledBy="{x:Bind FoliaNomandDotRadiusCard}"
                                            Value="{x:Bind ViewModel.FoliaNomandDotRadius, Mode=TwoWay}" />
                                    </Grid>
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Name="FoliaNomandDotContrastCard" x:Uid="FoliaNomandDotContrast">
                                    <Grid ColumnDefinitions="48,220" ColumnSpacing="12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind converters:SliderValueTextConverter.Format(FoliaNomandDotContrastSlider.Value), Mode=OneWay}" />
                                        <Slider
                                            x:Name="FoliaNomandDotContrastSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource FoliaSliderStyle}"
                                            Maximum="1"
                                            Minimum="0"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            StepFrequency="0.01"
                                            AutomationProperties.LabeledBy="{x:Bind FoliaNomandDotContrastCard}"
                                            Value="{x:Bind ViewModel.FoliaNomandDotContrast, Mode=TwoWay}" />
                                    </Grid>
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="FoliaNomandDotOriginal">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.FoliaNomandDotOriginal, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="FoliaNomandDotInverted">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.FoliaNomandDotInverted, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Name="FoliaNomandLensSpreadCard" x:Uid="FoliaNomandLensSpread">
                                    <Grid ColumnDefinitions="48,220" ColumnSpacing="12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind converters:SliderValueTextConverter.Format(FoliaNomandLensSpreadSlider.Value), Mode=OneWay}" />
                                        <Slider
                                            x:Name="FoliaNomandLensSpreadSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource FoliaSliderStyle}"
                                            Maximum="1"
                                            Minimum="0"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            StepFrequency="0.01"
                                            AutomationProperties.LabeledBy="{x:Bind FoliaNomandLensSpreadCard}"
                                            Value="{x:Bind ViewModel.FoliaNomandLensSpread, Mode=TwoWay}" />
                                    </Grid>
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Name="FoliaNomandLensBulgeCard" x:Uid="FoliaNomandLensBulge">
                                    <Grid ColumnDefinitions="48,220" ColumnSpacing="12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind converters:SliderValueTextConverter.Format(FoliaNomandLensBulgeSlider.Value), Mode=OneWay}" />
                                        <Slider
                                            x:Name="FoliaNomandLensBulgeSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource FoliaSliderStyle}"
                                            Maximum="1"
                                            Minimum="-1"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            StepFrequency="0.01"
                                            AutomationProperties.LabeledBy="{x:Bind FoliaNomandLensBulgeCard}"
                                            Value="{x:Bind ViewModel.FoliaNomandLensBulge, Mode=TwoWay}" />
                                    </Grid>
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Name="FoliaNomandLensDispersionCard" x:Uid="FoliaNomandLensDispersion">
                                    <Grid ColumnDefinitions="48,220" ColumnSpacing="12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind converters:SliderValueTextConverter.Format(FoliaNomandLensDispersionSlider.Value), Mode=OneWay}" />
                                        <Slider
                                            x:Name="FoliaNomandLensDispersionSlider"
                                            Grid.Column="1"
                                            Style="{StaticResource FoliaSliderStyle}"
                                            Maximum="1"
                                            Minimum="0"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            StepFrequency="0.01"
                                            AutomationProperties.LabeledBy="{x:Bind FoliaNomandLensDispersionCard}"
                                            Value="{x:Bind ViewModel.FoliaNomandLensDispersion, Mode=TwoWay}" />
                                    </Grid>
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Uid="FoliaNomandOverlay">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.FoliaNomandOverlay, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard x:Name="FoliaNomandOverlayOpacityCard" x:Uid="FoliaNomandOverlayOpacity">
                                    <Grid ColumnDefinitions="48,220" ColumnSpacing="12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextAlignment="Right"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind converters:SliderValueTextConverter.Format(FoliaNomandOverlayOpacitySlider.Value), Mode=OneWay}" />
                                        <Slider
                                            x:Name="FoliaNomandOverlayOpacitySlider"
                                            Grid.Column="1"
                                            Style="{StaticResource FoliaSliderStyle}"
                                            Maximum="1"
                                            Minimum="0"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            StepFrequency="0.01"
                                            AutomationProperties.LabeledBy="{x:Bind FoliaNomandOverlayOpacityCard}"
                                            Value="{x:Bind ViewModel.FoliaNomandOverlayOpacity, Mode=TwoWay}" />
                                    </Grid>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <TextBlock
                            x:Uid="FoliaFontSection"
                            Margin="10,20,10,10"
                            FontSize="16" />
                        <controls:SettingsCard x:Name="FoliaFontScaleCard" x:Uid="FoliaFontScale" Margin="10,0,10,0">
                            <Grid ColumnDefinitions="48,220" ColumnSpacing="12">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    TextAlignment="Right"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind converters:SliderValueTextConverter.Format(FoliaFontScaleSlider.Value), Mode=OneWay}" />
                                <Slider
                                    x:Name="FoliaFontScaleSlider"
                                    Grid.Column="1"
                                    Style="{StaticResource FoliaSliderStyle}"
                                    Maximum="200"
                                    Minimum="50"
                                    SmallChange="5"
                                    LargeChange="25"
                                    StepFrequency="5"
                                    AutomationProperties.LabeledBy="{x:Bind FoliaFontScaleCard}"
                                    Value="{x:Bind ViewModel.FoliaFontScale, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="FoliaFontFamily" Margin="10,0,10,0">
                            <ComboBox
                                x:Uid="FoliaFontPicker"
                                Width="220"
                                AutomationProperties.AutomationId="FoliaFontPicker"
                                ItemsSource="{x:Bind ViewModel.FoliaFonts}"
                                SelectedItem="{x:Bind ViewModel.SelectedFoliaFont, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="model:FontChoice">
                                        <TextBlock
                                            FontFamily="{x:Bind Family}"
                                            Text="{x:Bind DisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="FoliaFontWeightCard" x:Uid="FoliaFontWeight" Margin="10,0,10,0">
                            <Grid ColumnDefinitions="48,220" ColumnSpacing="12">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    TextAlignment="Right"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind converters:SliderValueTextConverter.Format(FoliaFontWeightSlider.Value), Mode=OneWay}" />
                                <Slider
                                    x:Name="FoliaFontWeightSlider"
                                    Grid.Column="1"
                                    Style="{StaticResource FoliaSliderStyle}"
                                    Maximum="900"
                                    Minimum="100"
                                    SmallChange="100"
                                    LargeChange="100"
                                    StepFrequency="100"
                                    AutomationProperties.LabeledBy="{x:Bind FoliaFontWeightCard}"
                                    Value="{x:Bind ViewModel.FoliaFontWeight, Mode=TwoWay}" />
                            </Grid>
                        </controls:SettingsCard>
                        <TextBlock
                            x:Uid="FoliaSourceSection"
                            Margin="10,20,10,10"
                            FontSize="16" />
                        <controls:SettingsCard x:Uid="FoliaLyricsSource" Margin="10,0,10,0">
                            <StackPanel MaxWidth="380" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.FoliaLyricsStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                <Button
                                    x:Uid="FoliaRetry"
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.RetryFoliaLyricsCommand}" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </StackPanel>
                </ScrollView>
            </controls:Case>
            <!--  关于  -->
            <controls:Case Value="About">
                <ScrollView>
                    <StackPanel Margin="32,0,32,24">
                        <StackPanel.ChildrenTransitions>
                            <EntranceThemeTransition FromVerticalOffset="100" IsStaggeringEnabled="True" />
                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                        </StackPanel.ChildrenTransitions>
                        <TextBlock
                            x:Uid="MusicPlayer"
                            Margin="10,10,0,10"
                            FontSize="16" />
                        <controls:SettingsCard
                            x:Name="OriginalSound"
                            x:Uid="OriginalSound"
                            Margin="10,0,10,0"
                            Command="{x:Bind ViewModel.OpenOriginalSoundCommand}"
                            Description="{x:Bind ViewModel.CopyrightNotice}"
                            HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/HQPlayer.png}"
                            IsClickEnabled="True" />
                        <TextBlock
                            x:Uid="SettingsAbout"
                            Margin="10,10,0,10"
                            FontSize="16" />
                        <controls:SettingsExpander
                            x:Uid="AppTitleHeader"
                            Margin="10,0,10,0"
                            Description="{x:Bind ViewModel.CopyrightNotice}"
                            HeaderIcon="{ui:BitmapIcon Source=ms-appx:///Assets/Square44x44Logo.altform-unplated_targetsize-32.png}">
                            <TextBlock
                                x:Name="Version"
                                Margin="10"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard ContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <HyperlinkButton
                                            x:Name="Github"
                                            Content="Github"
                                            NavigateUri="https://github.com/Johnwikix/SpectrumVisualization.git" />
                                        <HyperlinkButton
                                            x:Name="Gitee"
                                            Content="Gitee"
                                            NavigateUri="https://gitee.com/people_1/win-ex-spectrum-test" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                        <TextBlock
                            x:Uid="LyricsCacheTitle"
                            Margin="10,20,10,10"
                            FontSize="16" />
                        <controls:SettingsCard x:Uid="LyricsCacheEnabled" Margin="10,0,10,0">
                            <ToggleSwitch
                                x:Uid="LyricsCacheToggle"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.LyricsCacheEnabled, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            x:Uid="LyricsCacheFolder"
                            Margin="10,4,10,0"
                            IsEnabled="{x:Bind ViewModel.LyricsCacheEnabled, Mode=OneWay}">
                            <Grid
                                MaxWidth="430"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">
                                <TextBox
                                    x:Uid="LyricsCacheFolderInput"
                                    Width="220"
                                    Text="{x:Bind ViewModel.LyricsCacheFolder, Mode=TwoWay}" />
                                <Button
                                    x:Uid="LyricsCacheBrowse"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="LyricsCacheBrowse"
                                    Click="OnBrowseLyricsCacheClick" />
                            </Grid>
                        </controls:SettingsCard>
                        <TextBlock
                            Margin="10,8,10,0"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.LyricsCacheLocation, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Uid="GraphicsAttribution"
                            Margin="10,16,10,0"
                            FontSize="12"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollView>
            </controls:Case>
        </controls:SwitchPresenter>
    </Grid>
</winex:WindowEx>
