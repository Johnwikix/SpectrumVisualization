<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="WinExSpectrumTest.View.SettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinExSpectrumTest.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    Title="SettingWindow"
    Width="1280"
    Height="900"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winex:WindowEx.SystemBackdrop>
    <Grid Margin="32,32,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="32,0,32,0">
            <TextBlock Margin="10,20,0,10" FontSize="28" Text="设置" />
        </Grid>
        <ScrollView Grid.Row="1">
            <Grid Margin="32,0,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="100" IsStaggeringEnabled="True" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </Grid.ChildrenTransitions>
                <controls:SettingsCard Grid.Row="0" Margin="10,0,10,0" Header="旋转速度">
                    <Slider Maximum="100" Minimum="0" Value="{x:Bind ViewModel.RotationSpeed, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard Grid.Row="1" Margin="10,0,10,0" Header="图片不透明度">
                    <Slider Maximum="100" Minimum="0" Value="{x:Bind ViewModel.CoverOpacity, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard Grid.Row="2" Margin="10,0,10,0" Header="频谱条不透明度">
                    <Slider Maximum="100" Minimum="0" Value="{x:Bind ViewModel.SpectrumOpacity, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard Grid.Row="3" Margin="10,0,10,0" Header="频谱平滑系数">
                    <Slider Maximum="100" Minimum="0" Value="{x:Bind ViewModel.SmoothingFactor, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard Grid.Row="4" Margin="10,0,10,0" Header="频谱幅度系数">
                    <Slider Maximum="100" Minimum="0" Value="{x:Bind ViewModel.Sensitivity, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsExpander Grid.Row="5" Margin="10,0,10,0" Header="频谱样式">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="直线">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsDrawPlainSpectrum, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="圆形">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsDrawRoundSpectrum, Mode=TwoWay}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <controls:SettingsCard Grid.Row="6" Margin="10,0,10,0" Header="文字不透明度">
                    <Slider Maximum="100" Minimum="0" Value="{x:Bind ViewModel.FontOpacity, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsExpander Grid.Row="7" Margin="10,0,10,0" Header="主窗口材质">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <RadioButton
                                    x:Name="TransparentTintRadioButton"
                                    Command="{x:Bind ViewModel.ChangeBackdropTypeCommand, Mode=OneWay}"
                                    CommandParameter="TransparentTint"
                                    Content="透明"
                                    GroupName="BackdropGroup"
                                    Tag="TransparentTint" />
                                <RadioButton
                                    x:Name="MicaRadioButton"
                                    Command="{x:Bind ViewModel.ChangeBackdropTypeCommand, Mode=OneWay}"
                                    CommandParameter="Mica"
                                    Content="云母"
                                    GroupName="BackdropGroup"
                                    Tag="Mica" />
                                <RadioButton
                                    x:Name="AcrylicRadioButton"
                                    Command="{x:Bind ViewModel.ChangeBackdropTypeCommand, Mode=OneWay}"
                                    CommandParameter="Acrylic"
                                    Content="亚克力"
                                    GroupName="BackdropGroup"
                                    Tag="Acrylic" />
                                <RadioButton
                                    x:Name="TransparentAcrylicRadioButton"
                                    Command="{x:Bind ViewModel.ChangeBackdropTypeCommand, Mode=OneWay}"
                                    CommandParameter="TransparentAcrylic"
                                    Content="透明亚克力"
                                    GroupName="BackdropGroup"
                                    Tag="TransparentAcrylic" />
                                <RadioButton
                                    x:Name="CustomAcrylicStyleRadioButton"
                                    Command="{x:Bind ViewModel.ChangeBackdropTypeCommand, Mode=OneWay}"
                                    CommandParameter="CustomAcrylicStyle"
                                    Content="自定义亚克力"
                                    GroupName="BackdropGroup"
                                    Tag="CustomAcrylicStyle" />
                                <StackPanel Visibility="{x:Bind ViewModel.IsColorPickerVisible, Mode=OneWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Text="不透明度" />
                                        <Slider
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="{x:Bind ViewModel.CustomOpacity, Mode=TwoWay}" />
                                    </Grid>
                                    <ColorPicker
                                        ColorSpectrumShape="Ring"
                                        IsAlphaEnabled="True"
                                        IsAlphaSliderVisible="True"
                                        IsAlphaTextInputVisible="False"
                                        IsColorChannelTextInputVisible="False"
                                        IsColorSliderVisible="True"
                                        IsHexInputVisible="False"
                                        IsMoreButtonVisible="False"
                                        Color="{x:Bind ViewModel.CustomColor, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </Grid>
        </ScrollView>
    </Grid>
</winex:WindowEx>
